# Copie este arquivo para .env e ajuste os valores
# cp .env.example .env

# --- Instagram ---------------------------------------------------
# Uma única conta (compatibilidade). Se INSTALOADER_ACCOUNTS estiver
# preenchida abaixo, esta variável é ignorada.
INSTALOADER_USERNAME=seu_usuario

# Lista de contas (1 a 10, separadas por vírgula) para rotacionar durante
# a coleta — cada troca sorteia uma duração entre ACCOUNT_ROTATE_MIN_HOURS
# e ACCOUNT_ROTATE_MAX_HOURS antes de passar para a próxima conta.
# Cada conta precisa ter sessão preparada via `python scripts/login_accounts.py`
# antes de subir o coletor (veja o README, seção 2). Deixe em branco para
# usar só INSTALOADER_USERNAME (uma conta, sem rotação).
INSTALOADER_ACCOUNTS=

ACCOUNT_ROTATE_MIN_HOURS=1
ACCOUNT_ROTATE_MAX_HOURS=6

# Caminho para a pasta que contém os arquivos de sessão do Instaloader
# (um por conta: session-<username>). Também usado por
# `scripts/login_accounts.py` para salvar/verificar sessões no host.
# Use o caminho ABSOLUTO da pasta session/ criada na raiz do projeto:
#
#   Windows:  C:\Users\SeuUsuario\Documents\GitHub\seu-projeto\session
#   Linux:    /home/seu_usuario/seu-projeto/session
#   Mac:      /Users/seu_usuario/seu-projeto/session
#
# Não use caminhos relativos (.\session ou ./session) — o Docker
# no Windows não resolve caminhos relativos em volumes corretamente.
INSTALOADER_SESSION_PATH=C:\Users\SeuUsuario\Documents\GitHub\seu-projeto\session

# --- Janela de horário de coleta ----------------------------------
# Restringe quando o coletor pode fazer requisições ao Instagram — útil
# para misturar o tráfego da coleta com o uso normal de uma rede
# institucional (ex: horário comercial). Fora da janela/dias configurados,
# o coletor pausa e retoma sozinho quando ela reabrir (não encerra).
# Deixe COLLECT_WINDOW_START/END em branco para não restringir horário.
COLLECT_WINDOW_START=08:00
COLLECT_WINDOW_END=19:00

# Dias em que a janela vale: mon-fri (padrão), all, ou lista tipo mon,wed,fri
COLLECT_WINDOW_DAYS=mon-fri

# Timezone IANA usada para avaliar a janela — independente do
# relógio/timezone do container (que roda em UTC por padrão).
COLLECT_WINDOW_TZ=America/Sao_Paulo

# --- OpenStreetMap (.pbf) ---------------------------------------
# Baixe em: https://download.geofabrik.de/south-america/brazil.html
# Use o caminho ABSOLUTO do diretório onde o .pbf está salvo,
# ou . para apontar para a raiz do projeto (se o arquivo estiver lá).
OSM_PBF_DIR=.
OSM_PBF_FILE=espirito-santo-latest.osm.pbf

# --- Bounding box -----------------------------------------------
# Formato: lat_min,lon_min,lat_max,lon_max
# Padrao abaixo = Grande Vitoria ES
BBOX=-20.5,-40.5,-20.1,-40.1

# --- Modo de resolução de locations ----------------------------
# osm_name  = resolve por nome via OSM + fbsearch/places (padrão)
# geo_grid  = varre grade de coordenadas via location_search (Bellingcat)
LOCATION_RESOLVE_MODE=osm_name

# Cookie do Instagram — fallback manual para LOCATION_RESOLVE_MODE=geo_grid.
# Só é necessário se INSTALOADER_ACCOUNTS/INSTALOADER_USERNAME estiver vazio
# acima: com uma conta configurada, o cookie é derivado automaticamente da
# sessão ativa do Instaloader, sem precisar colar manualmente.
# Como obter (caso precise do fallback): abra o Instagram no browser →
#   DevTools (F12) → Network → clique em qualquer requisição →
#   Request Headers → copie o valor de "cookie"
IG_COOKIE=

# Espaçamento da grade em km (apenas para geo_grid)
# 1.0 = ~1600 pontos para Grande Vitória | 0.5 = ~6400 pontos (mais completo)
GEO_GRID_STEP_KM=1.0

# Endpoint(s) usados na varredura geo_grid (apenas para geo_grid):
#   mobile = i.instagram.com/api/v1/location_search (API do app mobile)
#   web    = www.instagram.com/location_search (técnica original do Bellingcat)
#   both   = tenta mobile primeiro; só tenta web se mobile falhar (padrão)
# Algumas contas têm um dos dois endpoints bloqueado/restrito mesmo com
# cookie válido — "both" dá resiliência tentando o outro antes de desistir.
GEO_GRID_ENDPOINT_MODE=both

# Pausa aleatória (segundos) entre cada chamada de busca de location
# (fbsearch/places no modo osm_name, location_search no modo geo_grid).
# Aumente se o Instagram estiver bloqueando por excesso de requisições.
T_MIN_SEARCH=8
T_MAX_SEARCH=16

# Pausa aleatória (segundos) na coleta de posts — após cada post processado
# e após cada location/hashtag visitada (mesmo sem posts). Endpoint menos
# restritivo que a busca de locations, por isso o padrão é mais rápido.
# Aumente se o Instagram estiver bloqueando por excesso de requisições.
T_MIN_POST=2.8
T_MAX_POST=6.0

# --- Modo de coleta ---------------------------------------------
# both          = coleta por locations (OSM) e por hashtags (padrao)
# location      = somente coleta por locations
# hashtag       = somente coleta por hashtags
# geo_grid_scan = só varre a grade geo_grid e salva locations no banco,
#                 sem coletar posts (requer LOCATION_RESOLVE_MODE=geo_grid).
#                 Dica: para ligar esse modo sem editar o .env, prefira
#                 `make scan-grid` — ele sobrescreve COLLECT_MODE só
#                 para aquela execução.
COLLECT_MODE=both

# --- Periodo de coleta -----------------------------------------
# Posts anteriores a esta data sao ignorados (formato: YYYY-MM-DD)
STOP_DATE=2026-01-01

# Opcional: posts mais recentes que esta data sao ignorados, formando uma
# janela [STOP_DATE, START_DATE]. Deixe em branco para nao limitar (pega
# ate o post mais recente de cada location/hashtag). Deve ser posterior a
# STOP_DATE.
START_DATE=

# --- Geracao automatica de hashtags -----------------------------
# true  = gera hashtags a partir dos nomes dos POIs do .pbf (padrao)
# false = usa apenas a lista fixa do hashtags.txt
HASHTAG_AUTO_GENERATE=true

# --- Banco de dados ---------------------------------------------
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=instagram
DB_PORT=5432
